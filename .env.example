# 环境变量（占位符，替换为你自己的配置）
# 复制此文件为 .env 并填入真实值
#
# 安全提示:
# - API Key 请使用系统环境变量，不要写入 .env
# - 系统环境变量优先于 .env（load_dotenv 使用 override=False）
# - 如果系统环境变量已设置 DEEPSEEK_API_KEY，.env 中的同名字段将被忽略

# ---- LLM API Key（按优先级递减）----
# 推荐将 API Key 设置为系统环境变量而非写入此文件
# DEEPSEEK_API_KEY=your_deepseek_key_here       # 优先级最高
# OPENAI_API_KEY=your_openai_key_here
# API_KEY=your_api_key_here
# DASHSCOPE_API_KEY=your_dashscope_key_here     # 优先级最低

# ---- API 地址（按优先级递减）----
# DEEPSEEK_BASE_URL=https://api.deepseek.com    # 使用 DEEPSEEK_API_KEY 时的默认值
# OPENAI_BASE_URL=https://api.deepseek.com
# BASE_URL=https://your-api-endpoint/v1

# ---- 模型名称（按优先级递减）----
# DEEPSEEK_MODEL=deepseek-v4-flash              # 使用 DEEPSEEK_API_KEY 时的默认值
# OPENAI_MODEL=deepseek-v4-flash
# MODEL_NAME=your-model-name
# LLM_MODEL=your-model-name

# ---- 可选项（已有默认值）----
# COLLECTION_NAME=enterprise_knowledge
# EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# EMBEDDING_MODEL_PATH=./backend/models/bge-small-zh-v1.5    # 本地开发/容器内路径
# 容器内推荐: /app/models/bge-small-zh-v1.5（Dockerfile COPY 目标路径）
# 运行 python scripts/download_embedding_model.py 下载模型
# HF_ENDPOINT=https://hf-mirror.com                  # Hugging Face 镜像（国内推荐，仅模型下载阶段使用）

# ---- 离线模式（企业部署） ----
# 设为 1 禁止运行时访问 huggingface.co，所有模型从本地加载
# 生产环境必须设为 1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# Reranker 模型（企业部署）
# RERANKER_MODEL_NAME=BAAI/bge-reranker-base
# 模型默认存放路径: backend/models/bge-reranker-base/
# 运行 python scripts/download_reranker.py 下载模型

# ---- 文本处理 ----
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# TOP_K=4
# MAX_CONTEXT_CHARS=8000
# REQUEST_TIMEOUT=60
# TEMPERATURE=0.1

# ---- 推理并发控制 (Phase 6) ----
# EMBEDDING_MAX_CONCURRENCY=2         # Embedding 最大并发推理数
# RERANKER_MAX_CONCURRENCY=1          # Reranker 最大并发推理数
# INFERENCE_QUEUE_TIMEOUT_SECONDS=30  # 推理排队超时（秒）
# INFERENCE_TASK_TIMEOUT_SECONDS=120  # 推理执行超时（秒）
# INFERENCE_THREAD_POOL_SIZE=2        # 共享推理线程池大小

# ---- 用户级并发 ----
# MAX_ACTIVE_RAG_REQUESTS_PER_USER=1  # 每个用户最大活跃问答数

# ---- LLM HTTP 连接池 ----
# LLM_CONNECT_TIMEOUT_SECONDS=10
# LLM_READ_TIMEOUT_SECONDS=120
# LLM_WRITE_TIMEOUT_SECONDS=30
# LLM_POOL_TIMEOUT_SECONDS=10
# LLM_MAX_CONNECTIONS=20
# LLM_MAX_KEEPALIVE_CONNECTIONS=10

# ---- Uvicorn ----
# UVICORN_WORKERS=1                   # 默认 1，>1 会重复加载模型
# UVICORN_LIMIT_CONCURRENCY=50
# UVICORN_BACKLOG=128
# UVICORN_TIMEOUT_KEEP_ALIVE=10

# ---- 文档上传 (Phase 8) ----
# UPLOAD_CHUNK_SIZE_BYTES=1048576     # 流式上传分块大小 (1MB)
# MAX_UPLOAD_SIZE_MB=50               # 单文件最大大小
# MAX_FILES_PER_UPLOAD_REQUEST=5      # 单次上传最大文件数

# ---- 文档后台任务 (Phase 8) ----
# DOCUMENT_TASK_WORKERS=1              # 后台索引 worker 数（2核4GB 推荐 1）
# DOCUMENT_TASK_QUEUE_SIZE=20          # 任务队列容量
# DOCUMENT_TASK_QUEUE_TIMEOUT_SECONDS=5
# DOCUMENT_PARSE_TIMEOUT_SECONDS=300   # 文档解析超时
# DOCUMENT_INDEX_TIMEOUT_SECONDS=600   # 索引超时
# MAX_CONCURRENT_UPLOADS=2            # 最大并发上传数
# MAX_CONCURRENT_INDEX_TASKS=1        # 最大并发索引任务
# MAX_PENDING_DOCUMENT_TASKS=20       # 最大待处理任务
# MAX_TASK_RETRY_COUNT=3              # 任务最大重试次数

# ---- API 限流 (Phase 9) ----
# TRUSTED_PROXIES=""                  # 可信代理 IP/网段（逗号分隔），Docker 内部自动信任常见网段
# SLOW_REQUEST_THRESHOLD_MS=3000      # 慢请求阈值（毫秒）
# VERY_SLOW_REQUEST_THRESHOLD_MS=10000  # 极慢请求阈值（毫秒）

# ---- 限流额度 (Phase 9) ----
# RATE_LIMIT_LOGIN_PER_MINUTE=10      # 每分钟最大登录次数
# RATE_LIMIT_REFRESH_PER_MINUTE=20    # 每分钟最大 Token 刷新次数
# RATE_LIMIT_CHAT_USER_PER_MINUTE=30  # 每分钟最大聊天请求次数
# RATE_LIMIT_CHAT_MESSAGE_PER_MINUTE=20  # 每分钟最大发送消息次数
# RATE_LIMIT_ADMIN_READ_PER_MINUTE=200   # 管理员每分钟最大读取次数
# RATE_LIMIT_ADMIN_WRITE_PER_MINUTE=30   # 管理员每分钟最大写入次数
# RATE_LIMIT_ADMIN_POLL_PER_MINUTE=20    # 管理员轮询限流
# RATE_LIMIT_UPLOAD_PER_MINUTE=10     # 每分钟最大上传次数
# RATE_LIMIT_HEALTH_PER_MINUTE=300    # 健康检查限流（高额度）

# ---- 磁盘监控 (Phase 10) ----
# DISK_WARNING_PERCENT=80             # 磁盘告警阈值（百分比）
# DISK_CRITICAL_PERCENT=90            # 磁盘严重告警阈值（百分比）
# MIN_FREE_DISK_MB=500               # 备份最低可用空间（MB）

# ---- 备份保留策略 (Phase 10) ----
# BACKUP_DAILY_KEEP=7                 # 每日备份保留天数
# BACKUP_WEEKLY_KEEP=4                # 每周备份保留份数
