# 后端环境变量示例
# 实际配置使用项目根目录的 .env 文件
# 后端通过 pydantic-settings 自动加载根目录 .env
# 系统环境变量优先于 .env

# 应用
APP_NAME=企业智库 AI API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false

# 服务
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# CORS（JSON 数组格式在 .env 中不易表达，使用代码默认值）
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 限制
MAX_QUESTION_LENGTH=2000

# ---- 认证 (Phase 2) ----
# JWT Secret Key — 安全生成方法:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 不得在此写入真实 Key，必须通过系统环境变量或项目根 .env 配置
# JWT_SECRET_KEY=

# 数据库
# DATABASE_URL=sqlite:///storage/app.db

# JWT 配置
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT_ISSUER=enterprise-knowledge-api
# JWT_AUDIENCE=enterprise-knowledge-client

# 登录安全
# MAX_LOGIN_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
